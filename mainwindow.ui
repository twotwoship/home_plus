  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget {
    background-color: #F5F6F7;
    color: #1F2328;
    font-family: &quot;Pretendard&quot;;
    font-size: 10pt;
}
QWidget#headerBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #D9DCE1;
}
QLabel#appTitleLabel {
    font-size: 12pt;
    font-weight: 600;
    color: #1F2328;
}
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #D9DCE1;
    border-radius: 4px;
    margin-top: 8px;
    padding: 24px 12px 12px 12px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    left: 12px;
    top: 6px;
    padding: 0;
    color: #6B7280;
}
QLabel {
    background: transparent;
    color: #1F2328;
}
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #D9DCE1;
    border-radius: 4px;
    padding: 6px 14px;
    color: #1F2328;
    min-height: 22px;
}
QPushButton:hover {
    background-color: #EEF0F2;
}
QPushButton:checked {
    background-color: #2F6FED;
    border-color: #2F6FED;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton:disabled {
    color: #A9AFB8;
    border-color: #E3E5E8;
}
QComboBox, QTimeEdit {
    background-color: #FFFFFF;
    border: 1px solid #D9DCE1;
    border-radius: 4px;
    padding: 4px 8px;
    color: #1F2328;
}
QTabWidget::pane {
    border: 1px solid #D9DCE1;
    border-radius: 4px;
    background-color: #FFFFFF;
    top: -1px;
}
QTabBar::tab {
    background-color: #F5F6F7;
    color: #6B7280;
    border: 1px solid #D9DCE1;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 16px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #1F2328;
    font-weight: 600;
}
QSplitter::handle {
    background-color: #F5F6F7;
    width: 6px;
}
QMenuBar, QStatusBar {
    background-color: #F5F6F7;
    color: #6B7280;
    border: none;
}</string>
